print(out)
PY
}

vb_mlx_synth() {
  local name="$1" text="$2" out="$3"
  python3 - "$TTS_HOST" "$CLIP_DIR" "$name" "$text" "$out" &lt;&lt;'PY'
import json, re, sys, urllib.error, urllib.request
from pathlib import Path
host, clip_dir, name, text, out = sys.argv[1:6]
clip = Path(clip_dir)
slug = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")
wav = None
for cand in (clip / f"{slug}_10s.wav", clip / f"{slug}.wav", clip / f"{slug}_10s.mp3"):
    if cand.exists():
        wav = cand
        break
if wav is None:
    sys.stderr.write(f"no sample wav for {name} ({slug})\n")
    sys.exit(3)
stem = wav.stem.replace("_10s", "")
srt = None
for cand in (wav.with_suffix(".srt"), clip / f"{slug}.srt", clip / f"{stem}.srt"):
    if cand.exists():
        srt = cand
        break
ref = ""
if srt is not None:
    lines = []
    for line in srt.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or re.fullmatch(r"\d+", line) or re.match(r"\d{2}:\d{2}:\d{2}", line):
            continue
        lines.append(line)
    ref = " ".join(lines)
if not ref:
    sys.stderr.write("missing reference transcript\n")
    sys.exit(3)
payload = json.dumps({
    "model": "mlx-community/Qwen3-TTS-12Hz-0.6B-Base-6bit",
    "input": text,
    "ref_audio": str(wav),
    "ref_text": ref,
    "speed": 1.0,
    "seed": 42,
}).encode()
req = urllib.request.Request(host + "/v1/audio/speech", data=payload, headers={"Content-Type": "application/json"}, method="POST")
try:
    with urllib.request.urlopen(req, timeout=90) as r:
        Path(out).write_bytes(r.read())
except urllib.error.HTTPError as e:
    sys.stderr.write(e.read().decode("utf-8", "replace")[:500])
    sys.exit(4)
print(wav.name)
PY
}

vb_play() {
  local f="$1"
  if command -v ffplay &gt;/dev/null; then
    ffplay -nodisp -autoexit -loglevel error "$f"
  else
    afplay "$f"
  fi
}

vb_srt_text() {
  python3 - "$1" &lt;&lt;'PY'
import re, sys
from pathlib import Path
p = Path(sys.argv[1])
if not p.exists():
    sys.exit(0)
lines = []
for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
    line = line.strip()
    if not line or re.fullmatch(r"\d+", line) or re.match(r"\d{2}:\d{2}:\d{2}[,.]\d+", line):
        continue
    lines.append(line)
print(" ".join(lines))
PY
}

vb_transcribe_file() {
  local api="$1" f="$2"
  local cmd resp rc
  cmd="$(/usr/bin/python3 -c 'import shlex,sys; api,f=sys.argv[1],sys.argv[2]; url=api+"/transcribe"; print(f"/usr/bin/curl -s --max-time 120 -X POST {shlex.quote(url)} -F file=@{shlex.quote(f)}")' "$api" "$f")"
  set +e
  resp="$(/usr/bin/curl -s --max-time 120 -X POST "${api}/transcribe" -F "file=@${f}")"
  rc=$?
  if [[ $rc -ne 0 || -z "$resp" ]]; then
    resp="$(vb_curl "$cmd")"
    rc=$?
  fi
  set -e
  if [[ $rc -ne 0 || -z "$resp" ]]; then
    vb_fail "Transcription request failed for $(basename "$f"). Is Voicebox running?"
  fi
  local text
  text="$(printf "%s" "$resp" | /usr/bin/python3 -c 'import json,sys
d=json.loads(sys.stdin.read() or "{}")
if "detail" in d:
    detail = d["detail"]
    if isinstance(detail, dict):
        msg = detail.get("message") or detail.get("detail") or str(detail)
    else:
        msg = str(detail)
    print(f"ERROR:{msg}")
    sys.exit(0)
text = d.get("text") or d.get("transcript") or d.get("transcription") or ""
print(text)')"
  if [[ "$text" == ERROR:* ]]; then
    vb_fail "${text#ERROR:}"
  fi
  [[ -n "$text" ]] || vb_fail "Empty transcript for $(basename "$f")."
  printf "%s" "$text"
}
vb_shell_start "new-cloned-voice"
FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] &amp;&amp; FILES+=("$line")
done &lt; &lt;(vb_collect_files "$@")
vb_log "new-cloned-voice" "collected=${#FILES[@]}"
set -- "${FILES[@]}"
API="$(vb_ensure)"
(( $# &gt; 0 )) || vb_fail "Select an audio file in Finder."
AUDIO=""
for f in "$@"; do
  f="$(vb_normalize_path "$f")"
  case "${f:l}" in
    *.wav|*.mp3|*.m4a|*.flac|*.ogg|*.aiff|*.aif) AUDIO="$f"; break ;;
  esac
done
[[ -n "$AUDIO" ]] || AUDIO="$(vb_normalize_path "$1")"
[[ -f "$AUDIO" ]] || vb_fail "Not a file: $AUDIO"
set +e
NAME="$(vb_finder_dialog "New Cloned Voice" "New voice name:")"
rc=$?
set -e
if [[ $rc -eq 0 &amp;&amp; -z "$NAME" ]]; then
  vb_log new-cloned-voice "dialog cancelled"
  exit 0
fi
if [[ $rc -ne 0 || -z "$NAME" ]]; then
  vb_fail "Name required."
fi
DIR="$(dirname "$AUDIO")"
BASE="$(basename "$AUDIO")"
STEM="${BASE%.*}"
SRT=""
for cand in "${DIR}/${STEM}.srt" "${DIR}/${STEM%_10s}.srt"; do
  [[ -f "$cand" ]] &amp;&amp; SRT="$cand" &amp;&amp; break
done
if [[ -n "$SRT" ]]; then
  REF="$(vb_srt_text "$SRT")"
else
  REF="$(vb_transcribe_file "$API" "$AUDIO")"
fi
[[ -n "$REF" ]] || vb_fail "Need a transcript (matching .srt or Whisper)."
BODY="$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1], "description": sys.argv[2], "language": "en", "voice_type": "cloned", "default_engine": "qwen"}))' "$NAME" "Cloned from $(basename "$AUDIO")")"
PROF="$(curl -sf --max-time 30 -X POST "${API}/profiles" -H "Content-Type: application/json" -d "$BODY")" \
  || vb_fail "Could not create profile (name may already exist)."
PID="$(printf "%s" "$PROF" | python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["id"])')"
curl -sf --max-time 60 -X POST "${API}/profiles/${PID}/samples" -F "file=@${AUDIO}" -F "reference_text=${REF}" &gt;/dev/null \
  || vb_fail "Could not add sample."
vb_log new-cloned-voice "created $NAME $PID"
vb_ok "Created voice ${NAME}."
</string>
